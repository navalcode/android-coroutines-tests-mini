<resources>
    <style name="Base.Theme.CoroutineTestsMini" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item><item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/accent</item><item name="colorOnSecondary">@color/accent_on</item>
        <item name="colorSurface">@color/paper</item><item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/soft</item><item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item><item name="colorError">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@color/legacy_navigation</item>
    </style>
    <style name="Theme.CoroutineTestsMini" parent="Base.Theme.CoroutineTestsMini" />
    <style name="TextAppearance.Mini.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/outfit_bold</item><item name="android:textSize">26sp</item><item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Mini.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/outfit_regular</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/muted</item>
    </style>
    <style name="TextAppearance.Mini.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/outfit_semibold</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Mini.State" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/outfit_semibold</item><item name="android:textSize">24sp</item><item name="android:textColor">@color/ink</item>
    </style>
    <style name="Widget.Mini.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item><item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">16sp</item><item name="android:elevation">0dp</item>
        <item name="backgroundTint">@color/button_background</item><item name="android:textColor">@color/button_text</item>
    </style>
</resources>
